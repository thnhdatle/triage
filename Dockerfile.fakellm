# SPDX-License-Identifier: Apache-2.0
# fakellm image: CGO-free, distroless/static, non-root. Base images pinned by digest.
FROM golang:1.27-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0
RUN go build -trimpath \
      -ldflags "-s -w -X github.com/thnhdatle/triage/internal/platform/buildinfo.Version=${VERSION} -X github.com/thnhdatle/triage/internal/platform/buildinfo.Commit=${COMMIT}" \
      -o /out/fakellm ./cmd/fakellm

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/fakellm /fakellm
USER 65532:65532
EXPOSE 8090
HEALTHCHECK --interval=5s --timeout=3s --start-period=2s --retries=3 CMD ["/fakellm","healthcheck"]
ENTRYPOINT ["/fakellm"]
